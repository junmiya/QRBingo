rules_version = '2';

// QRBingo v2 セキュリティルール
//
// 公平性・PIIフリーの原則(.specify/memory/constitution.md)により、
// クライアントからの直接 write は一切許可しない。
// ゲーム作成・参加・抽選・判定はすべて Cloud Functions (Admin SDK) 経由のみ。
// ここでは「誰が何を read できるか」だけを定義する。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isHost(gameId) {
      return signedIn() &&
        get(/databases/$(database)/documents/games/$(gameId)).data.hostUid == request.auth.uid;
    }

    // ゲーム本体: 状態・抽選履歴は参加者全員が購読する公開情報
    match /games/{gameId} {
      allow read: if signedIn();
      allow write: if false;

      // ランキング投影(伏字適用済み・当選コードは含まない)
      match /public/{docId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // 確定ランキング・当選コード(実ニックネーム含む)。ホストのみ読取可。
      match /private/{docId} {
        allow read: if isHost(gameId);
        allow write: if false;
      }

      // リーチ状況(演出用)。ホストのみ一覧を購読できる。
      // 書き込みは reportReach Function がサーバー検証の上で行う
      match /reaches/{uid} {
        allow read: if isHost(gameId);
        allow write: if false;
      }

      // 投げ銭の明細(金額・件数)。ホストのみ閲覧可。書き込みは Webhook のみ。
      match /tips/{tipId} {
        allow read: if isHost(gameId);
        allow write: if false;
      }

      // リーチ/ビンゴの全員向けアナウンス。参加者全員が購読(演出用)。
      // 書き込みは reportReach / submitChat Function がサーバー検証の上で行う。
      match /feed/{eventId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // チャット。ホストが有効化したゲームで参加者全員が購読・送信できる。
      // 送信は sendChat Function 経由のみ(内容検証・なりすまし防止)。
      match /chat/{msgId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // 重複カード排除用のロック。クライアントに公開する情報を持たない
      match /gridHashes/{hash} {
        allow read: if false;
        allow write: if false;
      }
    }

    // カード: シードは所有者のみ読める(他人のカードを推測させない)
    match /cards/{cardId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // 課金プラン(人数上限・有効期限)。本人のみ read。
    // write は Stripe Webhook / 運営(Admin SDK・コンソール)のみ。カード情報等の
    // PII は保持しない(Stripe 側に隔離)。
    match /entitlements/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow write: if false;
    }

    // Stripe Webhook の冪等記録(処理済みセッションID)。内部専用・クライアント非公開。
    match /stripeEvents/{sessionId} {
      allow read: if false;
      allow write: if false;
    }

    // Stripe Connect の接続状態(投げ銭の受取可否)。本人のみ read。
    // write は Connect オンボーディング Function / Webhook のみ。PII は保持しない。
    match /hostAccounts/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow write: if false;
    }

    // 運営設定(投げ銭手数料率など)。クライアント非公開・コンソール/管理のみ。
    match /config/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // ビンゴ申告: 結果は submitClaim の戻り値で本人に返すため、
    // Firestore からの直接購読は許可しない(Functions 内部専用)
    match /claims/{claimId} {
      allow read: if false;
      allow write: if false;
    }

    // 当選情報: 当選コードは本人とホストのみ(ランキング画面での照合に必要)。
    // resource == null(未作成)を許可することで、プレイヤーが finishGame より前に
    // 自分の当選ドキュメントを購読開始できる(存在すれば本人/ホストのみ read)。
    // 誰が当選したか自体は公開 leaderboard に出るため、この許可で漏れるのは
    // 「未作成 = null」のみで、当選コードは作成後に本人/ホストへ限定される。
    match /winners/{winnerId} {
      allow read: if signedIn() && (
        resource == null ||
        resource.data.uid == request.auth.uid ||
        isHost(resource.data.gameId)
      );
      allow write: if false;
    }
  }
}
